---
import { ClientRouter } from "astro:transitions";
import { getCollection, render } from "astro:content";
import "../../styles/global.css";

export async function getStaticPaths() {
	const posts = (await getCollection("posts"))
		.filter((post) => !post.data.draft)
		.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props as Awaited<ReturnType<typeof getStaticPaths>>[number]["props"];
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
	day: "2-digit",
	month: "long",
	year: "numeric",
});
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={post.data.excerpt} />
		<ClientRouter />
		<title>{post.data.title} — 一人の言葉</title>
	</head>
	<body>
		<header class="site-bar" transition:persist>
			<a href="/" class="brand" aria-label="一人の言葉 home">一人の言葉</a>
			<a class="post-back" href="/">Back to notes</a>
		</header>

		<main class="stage post-page" transition:animate="fade">
			<article class="post-sheet">
				<div class="post-mini-bar" aria-hidden="true">
					<span class="post-mini-title">{post.data.title}</span>
				</div>
				<header class="post-sheet-header">
					<p class="post-sheet-meta">{dateFormatter.format(post.data.date)}</p>
					<h1>{post.data.title}</h1>
					<p class="post-sheet-excerpt">{post.data.excerpt}</p>
				</header>

				<div class="post-sheet-body">
					<Content />
				</div>
			</article>
		</main>

		<style>
			.post-page {
				align-items: stretch;
				justify-items: stretch;
				height: calc(100dvh - 56px);
				padding: clamp(16px, 3.5vh, 32px);
				box-sizing: border-box;
			}

			.post-back {
				font-size: .78rem;
				text-decoration: none;
				color: var(--soft-ink);
			}

			.post-mini-bar {
				position: sticky;
				top: 0;
				z-index: 10;
				display: flex;
				align-items: center;
				width: 100%;
				height: 48px;
				margin-bottom: -48px;
				overflow: hidden;
				opacity: 0;
				transform: translateY(-100%);
				pointer-events: none;
				background: color-mix(in srgb, var(--surface) 88%, transparent);
				-webkit-backdrop-filter: blur(8px);
				backdrop-filter: blur(8px);
				border-bottom: 1px solid transparent;
				transition: transform .25s ease, opacity .25s ease, border-bottom-color .25s ease;
			}

			.post-mini-bar.is-visible {
				opacity: 1;
				transform: translateY(0);
				pointer-events: auto;
				border-bottom-color: var(--line);
			}

			.post-mini-title {
				padding: 0 clamp(16px, 4vw, 32px);
				font-family: var(--serif);
				font-size: .95rem;
				font-weight: 500;
				letter-spacing: -.02em;
				color: var(--ink);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			.post-sheet {
				width: 100%;
				height: 100%;
				border: 1px solid var(--line);
				background: var(--surface);
				box-shadow: 0 1px 0 rgba(0, 0, 0, .04);
				overflow-y: auto;
				overflow-x: hidden;
			}

			.post-sheet-header {
				padding: clamp(24px, 4vw, 52px);
				border-bottom: 1px solid var(--line);
			}

			.post-sheet-meta {
				margin-bottom: 12px;
				color: var(--soft-ink);
				font-size: .78rem;
			}

			h1 {
				margin-bottom: 18px;
				font-family: var(--serif);
				font-size: clamp(2.2rem, 6vw, 4.9rem);
				font-weight: 500;
				letter-spacing: -.06em;
				line-height: .95;
				white-space: normal;
			}

			.post-sheet-excerpt {
				max-width: 52ch;
				margin-bottom: 0;
				color: var(--soft-ink);
				font-size: clamp(1rem, 1.6vw, 1.12rem);
				line-height: 1.7;
			}

			.post-sheet-body {
				padding: clamp(24px, 4vw, 52px);
			}

			.post-sheet-body :global(p) {
				max-width: 62ch;
				margin: 0 0 1.3em;
				font-size: 1.03rem;
				line-height: 1.8;
			}

			.post-sheet-body :global(p:last-child) {
				margin-bottom: 0;
			}

			.post-sheet-body :global(h2) {
				margin: 2.2em 0 .7em;
				font-family: var(--serif);
				font-size: clamp(1.45rem, 2vw, 2rem);
				font-weight: 500;
				letter-spacing: -.045em;
			}

			.post-sheet-body :global(ul),
			.post-sheet-body :global(ol) {
				max-width: 62ch;
				padding-left: 1.2em;
				margin: 0 0 1.3em;
			}

			.post-sheet-body :global(li) {
				margin-bottom: .6em;
				line-height: 1.7;
			}

			@media (max-width: 640px) {
				.site-bar {
					padding-inline: 16px;
				}

				.post-page {
					height: calc(100dvh - 52px);
					padding: 12px;
				}

				.post-sheet-header,
				.post-sheet-body {
					padding: 20px 16px;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.post-mini-bar {
					transition: none;
				}
			}
		</style>

		<script>
			const initMiniBar = () => {
				const win = window as Window & {
					__miniBarObserver?: IntersectionObserver;
				};

				win.__miniBarObserver?.disconnect();

				const sheet = document.querySelector<HTMLElement>(".post-sheet");
				const header = document.querySelector<HTMLElement>(".post-sheet-header");
				const miniBar = document.querySelector<HTMLElement>(".post-mini-bar");
				if (!sheet || !header || !miniBar) return;

				win.__miniBarObserver = new IntersectionObserver((entries) => {
					const entry = entries[0];
					if (!entry) return;
					const isVisible = !entry.isIntersecting;
					miniBar.classList.toggle("is-visible", isVisible);
					miniBar.setAttribute("aria-hidden", isVisible ? "false" : "true");
				}, {
					root: sheet,
					threshold: 0,
				});

				win.__miniBarObserver.observe(header);
			};

			initMiniBar();
			document.addEventListener("astro:page-load", initMiniBar);
		</script>
	</body>
</html>
