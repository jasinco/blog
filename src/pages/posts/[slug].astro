---
import { ClientRouter } from "astro:transitions";
import { getCollection, render } from "astro:content";
import "../../styles/global.css";
// Deep import: the package root pulls in the native renderer, which the Cloudflare build can't bundle
import { getImagePath } from "astro-takumi/dist/util.js";
import Ascii from "ascii.rest/astro";

export async function getStaticPaths() {
	const posts = (await getCollection("posts"))
		.filter((post) => !post.data.draft)
		.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props as Awaited<ReturnType<typeof getStaticPaths>>[number]["props"];
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
const minHeadingDepth = tocHeadings.length > 0 ? Math.min(...tocHeadings.map((h) => h.depth)) : 1;

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
	day: "2-digit",
	month: "long",
	year: "numeric",
});

const postTransitionAnim = {
	old: {
		name: "astroFadeOut",
		duration: "240ms",
		easing: "cubic-bezier(0.16, 1, 0.3, 1)",
		fillMode: "both",
	},
	new: [
		{
			name: "astroFadeIn",
			duration: "680ms",
			easing: "cubic-bezier(0.16, 1, 0.3, 1)",
			fillMode: "both",
		},
		{
			name: "postScaleFromHalf",
			duration: "680ms",
			easing: "cubic-bezier(0.16, 1, 0.3, 1)",
			fillMode: "both",
		},
	],
};

const postTransition = {
	forwards: postTransitionAnim,
	backwards: postTransitionAnim,
};
const { url, site } = Astro;
const openGraphImageUrl = getImagePath({ url, site });
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={post.data.excerpt} />

		<meta property="og:title" content={`${post.data.title} — 一人の言葉`} />
		<meta property="og:description" content={post.data.excerpt} />
		<meta property="og:type" content="article" />
		<meta property="og:url" content={url.href} />
		<meta property="og:image" content={openGraphImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${post.data.title} — 一人の言葉`} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${post.data.title} — 一人の言葉`} />
		<meta name="twitter:description" content={post.data.excerpt} />
		<meta name="twitter:image" content={openGraphImageUrl} />
		<meta name="twitter:image:alt" content={`${post.data.title} — 一人の言葉`} />

		<ClientRouter />
		<title>{post.data.title} — 一人の言葉</title>
	</head>
	<body>
		<header class="site-bar" transition:persist>
			<a class="toolbar_tag" href="/">Home</a>
			<a class="toolbar_tag" href="/">Photos</a>
			<a class="toolbar_tag" href="https://github.com/jasinco">github</a>
		</header>
		<Ascii piece="alpine-dawn" class="animation-bg" fps={4}/>

		<main class="stage post-page" transition:animate={postTransition}>
			<article class="post-sheet">
				<div class="post-mini-bar" aria-hidden="true">
					<span class="post-mini-title">{post.data.title}</span>
				</div>
				<header class="post-sheet-header">
					<div class="post-sheet-meta-bar">
						<p class="post-sheet-meta">{dateFormatter.format(post.data.date)}</p>
						{post.data.tags && post.data.tags.length > 0 && (
							<div class="post-sheet-tags" aria-label="Tags">
								{post.data.tags.map((tag) => (
									<a href={`/?tag=${encodeURIComponent(tag)}`} class="post-tag-link" aria-label={`View notes tagged #${tag}`}>
										#{tag}
									</a>
								))}
							</div>
						)}
					</div>
					<h1>{post.data.title}</h1>
					<p class="post-sheet-excerpt">{post.data.excerpt}</p>
				</header>

				<div class="post-sheet-layout">
					<div class="post-sheet-body">
						<Content />
					</div>
					{tocHeadings.length > 0 && (
						<aside class="post-toc" aria-label="Table of contents">
							<p class="post-toc-title">On this page</p>
							<nav class="post-toc-nav">
								<ol class="post-toc-list">
									{tocHeadings.map((heading) => (
										<li
											class="post-toc-item"
											data-depth={Math.min(2, heading.depth - minHeadingDepth)}
										>
											<a
												href={`#${heading.slug}`}
												class="post-toc-link"
												data-toc-slug={heading.slug}
											>
												{heading.text}
											</a>
										</li>
									))}
								</ol>
							</nav>
						</aside>
					)}
				</div>
			</article>
		</main>

		<style>
			.post-page {
				align-items: stretch;
				justify-items: stretch;
				height: calc(100dvh - var(--bar-height));
				padding: 5vh clamp(100px, 17vw, 260px) 0; 
				/* padding-left:17vw; */
				/* padding-right:17vw; */
				/* The sheet runs to the bottom of the viewport */
				padding-bottom: 0;
				/* The sheet starts 20% down the viewport and rises to the bar as it scrolls
				   (--sheet-scroll is set by the script) */
				--sheet-start-ratio: .2;
				--sheet-start: calc((100dvh - var(--bar-height)) * var(--sheet-start-ratio));
				padding-top: max(0px, calc(var(--sheet-start) - var(--sheet-scroll, 0px)));
				/* margin-top:50px; */
				box-sizing: border-box;
			}

			/* Too short to scroll the gap closed: start at the bar instead */
			.post-page.is-short {
				--sheet-start: 0px;
			}

			/* Dim the misty-forest backdrop so it sits further behind the post */
			:global(ascii-art.animation-bg) {
				overflow: hidden;
				filter: brightness(.76);
				/* color: green; */
			}

			/* The piece keeps its own aspect ratio; stretch it over the viewport and crop like a cover image */
			:global(ascii-art.animation-bg > canvas),
			:global(ascii-art.animation-bg > pre),
			:global(ascii-art.animation-bg > div) {
				height: 100%;
				object-fit: cover;
			}

			/* The backdrop covers the whole viewport here, so lift the bar above it */
			.site-bar {
				position: relative;
				z-index: 1;
				background: color-mix(in srgb, var(--surface) 40%, transparent);
				/* -webkit-backdrop-filter: blur(2px); */
				/* backdrop-filter: blur(2px); */
			}

			.post-back {
				font-size: .78rem;
				text-decoration: none;
				color: var(--soft-ink);
			}

			.post-mini-bar {
				position: sticky;
				top: 0;
				z-index: 10;
				display: flex;
				align-items: center;
				width: 100%;
				height: 48px;
				margin-bottom: -48px;
				overflow: hidden;
				opacity: 0;
				visibility: hidden;
				transform: translate3d(0, -100%, 0);
				pointer-events: none;
				background: color-mix(in srgb, var(--surface) 88%, transparent);
				border-bottom: 1px solid transparent;
				transition: transform .25s ease, opacity .25s ease, border-bottom-color .25s ease, visibility 0s linear .25s;
			}

			.post-mini-bar.is-visible {
				opacity: 1;
				visibility: visible;
				transform: translate3d(0, 0, 0);
				pointer-events: auto;
				-webkit-backdrop-filter: blur(8px);
				backdrop-filter: blur(8px);
				border-bottom-color: var(--line);
				transition: transform .25s ease, opacity .25s ease, border-bottom-color .25s ease, visibility 0s linear 0s;
			}

			.post-mini-title {
				padding: 0 clamp(16px, 4vw, 32px);
				font-family: var(--serif);
				font-size: .95rem;
				font-weight: 500;
				letter-spacing: -.02em;
				color: var(--ink);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			.post-sheet {
				width: 100%;
				height: 100%;
				border: 1px solid var(--line);
				background: var(--surface);
				box-shadow: 0 1px 0 rgba(0, 0, 0, .04);
				overflow-y: auto;
				overflow-x: hidden;
			}

			.post-sheet-header {
				padding: clamp(24px, 4vw, 52px);
				border-bottom: 1px solid var(--line);
			}

			.post-sheet-meta-bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 12px;
				margin-bottom: 12px;
			}

			.post-sheet-meta {
				margin-bottom: 0;
				color: var(--soft-ink);
				font-size: .78rem;
			}

			.post-sheet-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 6px;
			}

			.post-tag-link {
				display: inline-flex;
				align-items: center;
				min-height: 24px;
				padding: 3px 9px;
				background: transparent;
				border: 1px solid var(--line-strong);
				border-radius: 2px;
				color: var(--soft-ink);
				font-family: var(--mono);
				font-size: .74rem;
				line-height: 1.3;
				text-decoration: none;
				transition: all .15s ease;
			}

			.post-tag-link:hover {
				color: var(--green-ink);
				border-color: var(--green-ink);
				background: var(--green-wash);
			}

			h1 {
				margin-bottom: 18px;
				font-family: var(--serif);
				font-size: clamp(2.2rem, 6vw, 4.9rem);
				font-weight: 500;
				letter-spacing: -.035em;
				line-height: .95;
				white-space: normal;
			}

			.post-sheet-excerpt {
				max-width: 52ch;
				margin-bottom: 0;
				color: var(--soft-ink);
				font-size: clamp(1rem, 1.6vw, 1.12rem);
				line-height: 1.7;
			}

			.post-sheet-layout {
				display: flex;
				align-items: flex-start;
			}

			.post-sheet-body {
				flex: 1 1 0%;
				min-width: 0;
				padding: clamp(24px, 4vw, 52px);
			}

			.post-toc {
				position: sticky;
				top: 48px;
				flex: 0 0 clamp(180px, 16vw, 240px);
				max-height: calc(100dvh - var(--bar-height) - 48px);
				display: flex;
				flex-direction: column;
				padding: clamp(24px, 4vw, 44px) clamp(18px, 2.5vw, 32px) 28px 0;
			}

			.post-toc-title {
				margin: 0 0 10px;
				padding-left: 14px;
				font-family: var(--mono);
				font-size: .68rem;
				font-weight: 600;
				letter-spacing: .08em;
				text-transform: uppercase;
				color: var(--soft-ink);
				opacity: .75;
			}

			.post-toc-nav {
				min-height: 0;
				overflow-y: auto;
				overflow-x: hidden;
				padding-right: 4px;
			}

			.post-toc-list {
				list-style: none;
				margin: 0;
				padding: 0;
				border-left: 1px solid var(--line);
			}

			.post-toc-item {
				margin: 0;
				padding: 0;
			}

			.post-toc-link {
				display: block;
				margin-left: -1px;
				padding: 4px 10px 4px 13px;
				border-left: 2px solid transparent;
				color: var(--soft-ink);
				font-family: var(--mono);
				font-size: .76rem;
				line-height: 1.45;
				text-decoration: none;
				overflow-wrap: anywhere;
				transition: color .15s ease, border-left-color .15s ease, background-color .15s ease;
			}

			.post-toc-item[data-depth="1"] .post-toc-link {
				padding-left: 24px;
				font-size: .73rem;
				opacity: .86;
			}

			.post-toc-item[data-depth="2"] .post-toc-link {
				padding-left: 35px;
				font-size: .7rem;
				opacity: .75;
			}

			.post-toc-link:hover {
				color: var(--ink);
				opacity: 1;
				border-left-color: var(--line-strong);
			}

			.post-toc-link.is-active {
				color: var(--green-ink);
				opacity: 1;
				border-left-color: var(--green-ink);
				background: color-mix(in srgb, var(--green-wash) 45%, transparent);
			}

			.post-sheet-body :global(p) {
				max-width: 62ch;
				margin: 0 0 1.3em;
				font-size: 1.03rem;
				line-height: 1.8;
			}

			.post-sheet-body :global(p:last-child) {
				margin-bottom: 0;
			}

			.post-sheet-body :global(h1),
			.post-sheet-body :global(h2),
			.post-sheet-body :global(h3),
			.post-sheet-body :global(h4),
			.post-sheet-body :global(h5),
			.post-sheet-body :global(h6) {
				scroll-margin-top: 68px;
			}

			.post-sheet-body :global(h1),
			.post-sheet-body :global(h2) {
				margin: 1.8em 0 .7em;
				font-family: var(--serif);
				font-size: clamp(1.45rem, 2vw, 2rem);
				font-weight: 500;
				letter-spacing: -.025em;
			}

			.post-sheet-body :global(h3) {
				margin: 1.4em 0 .5em;
				font-family: var(--serif);
				font-size: clamp(1.15rem, 1.5vw, 1.35rem);
				font-weight: 500;
				letter-spacing: -.03em;
			}

			/* Section Folding & Indent Guide Lines */
			.post-sheet-body :global(.fold-section) {
				position: relative;
			}

			.post-sheet-body :global(.fold-header) {
				position: relative;
				display: flex;
				align-items: center;
				gap: 8px;
				margin-top: 1.8em;
				margin-bottom: .6em;
			}

			.post-sheet-body :global(.fold-section:first-child > .fold-header) {
				margin-top: .4em;
			}

			.post-sheet-body :global(.fold-header > h1),
			.post-sheet-body :global(.fold-header > h2),
			.post-sheet-body :global(.fold-header > h3),
			.post-sheet-body :global(.fold-header > h4),
			.post-sheet-body :global(.fold-header > h5),
			.post-sheet-body :global(.fold-header > h6) {
				margin: 0 !important;
			}

			.post-sheet-body :global(.fold-toggle) {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 18px;
				height: 18px;
				padding: 0;
				background: transparent;
				border: none;
				border-radius: 3px;
				color: var(--soft-ink);
				cursor: pointer;
				opacity: .45;
				transition: opacity .15s ease, background-color .15s ease, color .15s ease;
				flex-shrink: 0;
			}

			.post-sheet-body :global(.fold-header:hover .fold-toggle),
			.post-sheet-body :global(.fold-toggle:hover),
			.post-sheet-body :global(.fold-toggle:focus-visible) {
				opacity: 1;
				color: var(--green-ink);
				background: color-mix(in srgb, var(--green-wash) 60%, transparent);
			}

			.post-sheet-body :global(.fold-toggle:focus-visible) {
				outline: 2px solid var(--green-ink);
				outline-offset: 1px;
			}

			.post-sheet-body :global(.fold-chevron) {
				display: block;
				transition: transform .2s cubic-bezier(0.16, 1, 0.3, 1);
				transform: rotate(90deg);
			}

			.post-sheet-body :global(.fold-section.is-folded > .fold-header .fold-chevron) {
				transform: rotate(0deg);
			}

			.post-sheet-body :global(.fold-section.is-folded > .fold-header .fold-toggle) {
				opacity: .85;
				color: var(--green-ink);
			}

			.post-sheet-body :global(.fold-section.is-empty > .fold-header .fold-toggle) {
				visibility: hidden;
				pointer-events: none;
			}

			.post-sheet-body :global(.fold-badge) {
				display: none;
				align-items: center;
				justify-content: center;
				padding: 1px 7px;
				font-family: var(--mono);
				font-size: .68rem;
				line-height: 1.3;
				color: var(--soft-ink);
				background: color-mix(in srgb, var(--surface) 90%, white 10%);
				border: 1px solid var(--line);
				border-radius: 3px;
				cursor: pointer;
				transition: all .15s ease;
				user-select: none;
			}

			.post-sheet-body :global(.fold-badge:hover) {
				color: var(--green-ink);
				border-color: var(--green-ink);
				background: var(--green-wash);
			}

			.post-sheet-body :global(.fold-section.is-folded > .fold-header .fold-badge) {
				display: inline-flex;
			}

			.post-sheet-body :global(.fold-body) {
				position: relative;
				padding-left: 26px;
			}

			.post-sheet-body :global(.fold-section.is-folded > .fold-body) {
				display: none;
			}

			.post-sheet-body :global(ol) {
				list-style-type: decimal;
				max-width: 62ch;
				padding-left: 1.8em;
				margin: 0 0 1.3em;
			}

			.post-sheet-body :global(ul) {
				list-style-type: disc;
				max-width: 62ch;
				padding-left: 1.5em;
				margin: 0 0 1.3em;
			}

			.post-sheet-body :global(ol ol) {
				list-style-type: lower-alpha;
				margin: .4em 0;
				padding-left: 1.4em;
			}

			.post-sheet-body :global(ol ol ol) {
				list-style-type: lower-roman;
			}

			.post-sheet-body :global(ul ul) {
				list-style-type: circle;
				margin: .4em 0;
				padding-left: 1.4em;
			}

			.post-sheet-body :global(ol > li::marker) {
				font-family: var(--mono);
				font-size: .88em;
				font-weight: 500;
				color: var(--soft-ink);
			}

			.post-sheet-body :global(ul > li::marker) {
				color: var(--soft-ink);
			}

			.post-sheet-body :global(li) {
				margin-bottom: .6em;
				line-height: 1.7;
				padding-left: .25em;
			}

			.post-sheet-body :global(li:last-child) {
				margin-bottom: 0;
			}

			/* Tables */
			.post-sheet-body :global(.table-wrapper) {
				width: 100%;
				max-width: 100%;
				margin: 1.8em 0 2.2em;
				overflow-x: auto;
				-webkit-overflow-scrolling: touch;
				border: 1px solid var(--line);
				border-radius: 2px;
				background: color-mix(in srgb, var(--surface) 60%, transparent);
			}

			.post-sheet-body :global(table) {
				width: 100%;
				border-collapse: collapse;
				border-spacing: 0;
				margin: 1.8em 0 2.2em;
				font-size: .92rem;
				line-height: 1.6;
				text-align: left;
			}

			.post-sheet-body :global(.table-wrapper > table) {
				margin: 0;
			}

			.post-sheet-body :global(thead) {
				background: color-mix(in srgb, var(--canvas) 60%, var(--surface) 40%);
				border-bottom: 1px solid var(--line);
			}

			.post-sheet-body :global(th) {
				padding: 12px 18px;
				font-family: var(--mono);
				font-size: .74rem;
				font-weight: 600;
				letter-spacing: .08em;
				text-transform: uppercase;
				color: var(--soft-ink);
				white-space: nowrap;
				border-bottom: 1px solid var(--line);
			}

			.post-sheet-body :global(td) {
				padding: 13px 18px;
				border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
				color: var(--ink);
				vertical-align: middle;
			}

			.post-sheet-body :global(tbody tr:last-child td) {
				border-bottom: none;
			}

			.post-sheet-body :global(tbody tr) {
				transition: background-color .15s ease;
			}

			.post-sheet-body :global(tbody tr:hover) {
				background: color-mix(in srgb, var(--green-wash) 30%, transparent);
			}

			.post-sheet-body :global(td:first-child) {
				font-weight: 500;
				color: var(--ink);
			}

			.post-sheet-body :global(td code) {
				font-family: var(--code);
				font-size: .84em;
				padding: 2px 6px;
				background: var(--green-wash);
				color: var(--green-ink);
				border: 1px solid var(--line);
				border-radius: 2px;
			}

			/* Code blocks: bordered, with a copy button in the top-right corner */
			.post-sheet-body :global(.code-block) {
				position: relative;
				margin: 1.6em 0;
				border: 1px solid var(--line);
				border-radius: 4px;
				overflow: hidden;
			}

			.post-sheet-body :global(.code-block > pre) {
				margin: 0;
				padding: 16px 18px;
				font-size: .86rem;
				line-height: 1.6;
			}

			/* Line numbers (CSS counters, so they're never part of the copied text) */
			.post-sheet-body :global(.code-block > pre > code) {
				counter-reset: code-line;
			}

			.post-sheet-body :global(.code-block .line)::before {
				counter-increment: code-line;
				content: counter(code-line);
				display: inline-block;
				width: 2.5ch;
				margin-right: 1.4em;
				text-align: right;
				color: var(--soft-ink);
				opacity: .4;
				user-select: none;
				-webkit-user-select: none;
			}

			.post-sheet-body :global(.code-copy) {
				position: absolute;
				top: 8px;
				right: 8px;
				display: inline-flex;
				align-items: center;
				gap: 5px;
				padding: 3px 8px;
				border: 1px solid var(--line);
				border-radius: 3px;
				background: color-mix(in srgb, var(--surface) 85%, transparent);
				color: var(--soft-ink);
				font-family: var(--mono);
				font-size: .7rem;
				line-height: 1.3;
				cursor: pointer;
				opacity: .55;
				-webkit-backdrop-filter: blur(4px);
				backdrop-filter: blur(4px);
				transition: opacity .15s ease, color .15s ease, border-color .15s ease, background-color .15s ease;
			}

			.post-sheet-body :global(.code-block:hover .code-copy),
			.post-sheet-body :global(.code-copy:focus-visible) {
				opacity: 1;
			}

			.post-sheet-body :global(.code-copy:hover) {
				color: var(--green-ink);
				border-color: var(--green-ink);
				background: var(--green-wash);
			}

			.post-sheet-body :global(.code-copy:focus-visible) {
				outline: 2px solid var(--green-ink);
				outline-offset: 1px;
			}

			.post-sheet-body :global(.code-copy.is-copied) {
				opacity: 1;
				color: var(--green-ink);
				border-color: var(--green-ink);
			}

			/* Links: underlined, with a trailing ↗ */
			.post-sheet-body :global(a[href]) {
				color: var(--green-ink);
				text-decoration: underline;
				text-decoration-color: color-mix(in srgb, var(--green-ink) 45%, transparent);
				text-decoration-thickness: 1px;
				text-underline-offset: .22em;
				transition: color .15s ease, text-decoration-color .15s ease;
			}

			.post-sheet-body :global(a[href])::after {
				content: "↗";
				display: inline-block; /* keeps the arrow out of the underline */
				margin-left: .12em;
				font-size: .78em;
				line-height: 1;
				vertical-align: .18em;
				transition: transform .15s ease;
			}

			.post-sheet-body :global(a[href]:hover) {
				color: var(--ink);
				text-decoration-color: currentColor;
			}

			.post-sheet-body :global(a[href]:hover)::after {
				transform: translate(1px, -1px);
			}

			/* Scrollbars: thin pill thumb, no track, brightens to green on hover */
			.post-sheet,
			.post-toc-nav,
			.post-sheet-body :global(.table-wrapper),
			.post-sheet-body :global(.code-block > pre),
			.post-sheet-body :global(.typst-display-wrapper) {
				--scroll-thumb: rgba(240, 240, 232, .16);
				--scroll-thumb-hover: color-mix(in srgb, var(--green-ink) 60%, transparent);
			}

			@supports not selector(::-webkit-scrollbar) {
				.post-sheet,
				.post-toc-nav,
				.post-sheet-body :global(.table-wrapper),
				.post-sheet-body :global(.code-block > pre),
				.post-sheet-body :global(.typst-display-wrapper) {
					scrollbar-width: thin;
					scrollbar-color: var(--scroll-thumb) transparent;
				}
			}

			.post-sheet::-webkit-scrollbar {
				width: 10px;
			}

			.post-toc-nav::-webkit-scrollbar {
				width: 6px;
			}

			.post-sheet-body :global(.table-wrapper)::-webkit-scrollbar,
			.post-sheet-body :global(.code-block > pre)::-webkit-scrollbar,
			.post-sheet-body :global(.typst-display-wrapper)::-webkit-scrollbar {
				height: 8px;
			}

			.post-sheet::-webkit-scrollbar-track,
			.post-toc-nav::-webkit-scrollbar-track,
			.post-sheet-body :global(.table-wrapper)::-webkit-scrollbar-track,
			.post-sheet-body :global(.code-block > pre)::-webkit-scrollbar-track,
			.post-sheet-body :global(.typst-display-wrapper)::-webkit-scrollbar-track {
				background: transparent;
			}

			.post-sheet::-webkit-scrollbar-button,
			.post-toc-nav::-webkit-scrollbar-button,
			.post-sheet-body :global(.table-wrapper)::-webkit-scrollbar-button,
			.post-sheet-body :global(.code-block > pre)::-webkit-scrollbar-button,
			.post-sheet-body :global(.typst-display-wrapper)::-webkit-scrollbar-button {
				display: none;
			}

			.post-sheet::-webkit-scrollbar-corner {
				background: transparent;
			}

			.post-sheet::-webkit-scrollbar-thumb,
			.post-toc-nav::-webkit-scrollbar-thumb,
			.post-sheet-body :global(.table-wrapper)::-webkit-scrollbar-thumb,
			.post-sheet-body :global(.code-block > pre)::-webkit-scrollbar-thumb,
			.post-sheet-body :global(.typst-display-wrapper)::-webkit-scrollbar-thumb {
				background: var(--scroll-thumb);
				background-clip: padding-box;
				border: 3px solid transparent;
				border-radius: 999px;
			}

			.post-toc-nav::-webkit-scrollbar-thumb,
			.post-sheet-body :global(.table-wrapper)::-webkit-scrollbar-thumb,
			.post-sheet-body :global(.code-block > pre)::-webkit-scrollbar-thumb,
			.post-sheet-body :global(.typst-display-wrapper)::-webkit-scrollbar-thumb {
				border-width: 2px;
			}

			.post-sheet::-webkit-scrollbar-thumb:hover,
			.post-sheet::-webkit-scrollbar-thumb:active,
			.post-toc-nav::-webkit-scrollbar-thumb:hover,
			.post-toc-nav::-webkit-scrollbar-thumb:active,
			.post-sheet-body :global(.table-wrapper)::-webkit-scrollbar-thumb:hover,
			.post-sheet-body :global(.code-block > pre)::-webkit-scrollbar-thumb:hover,
			.post-sheet-body :global(.table-wrapper)::-webkit-scrollbar-thumb:active,
			.post-sheet-body :global(.code-block > pre)::-webkit-scrollbar-thumb:active,
			.post-sheet-body :global(.typst-display-wrapper)::-webkit-scrollbar-thumb:hover,
			.post-sheet-body :global(.typst-display-wrapper)::-webkit-scrollbar-thumb:active {
				background: var(--scroll-thumb-hover);
				background-clip: padding-box;
			}

			@media (max-width: 1024px) {
				.post-toc {
					display: none;
				}
			}

			@media (max-width: 640px) {
				.site-bar {
					padding-inline: 16px;
				}

				.post-page {
					padding: 12px 12px 0;
					padding-top: max(0px, calc(var(--sheet-start) - var(--sheet-scroll, 0px)));
				}

				.post-sheet-header,
				.post-sheet-body {
					padding: 20px 16px;
				}

				.post-sheet-body :global(.fold-body) {
					padding-left: 18px;
				}

				/* Code blocks span the full column, centred, however deeply they're nested.
				   Nesting only indents from the left, so the parent's right edge matches the column's:
				   pulling left by (parent width − column width) lines both edges up. */
				.post-sheet-body {
					container-type: inline-size;
				}

				.post-sheet-body :global(.code-block) {
					width: 100cqi;
					margin-left: calc(100% - 100cqi);
				}

				.post-sheet-body :global(th),
				.post-sheet-body :global(td) {
					padding: 10px 14px;
					font-size: .85rem;
				}

				.post-sheet-body :global(th) {
					font-size: .7rem;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.post-mini-bar {
					transition: none;
				}

				.post-sheet {
					opacity: 1 !important;
					transform: none !important;
				}
			}
		</style>

		<style is:global>
			@keyframes postScaleFromHalf {
				from {
					transform-origin: top center;
					transform: scale(0.5);
				}
				to {
					transform-origin: top center;
					transform: scale(1);
				}
			}
		</style>

		<script>
			// Feeds the sheet's scroll offset to CSS, which closes the gap above the sheet
			const initSheetLift = () => {
				const win = window as Window & {
					__sheetLiftObserver?: ResizeObserver;
				};
				win.__sheetLiftObserver?.disconnect();

				const page = document.querySelector<HTMLElement>(".post-page");
				const sheet = document.querySelector<HTMLElement>(".post-sheet");
				if (!page || !sheet) return;

				// The gap closes only if the post can scroll that far once the sheet fills the page
				const checkLength = () => {
					const ratio = parseFloat(getComputedStyle(page).getPropertyValue("--sheet-start-ratio")) || 0;
					const fullHeight = page.clientHeight;
					page.classList.toggle("is-short", sheet.scrollHeight - fullHeight < fullHeight * ratio);
				};
				// Re-check when the window resizes or the post's height changes (folds, images, math)
				win.__sheetLiftObserver = new ResizeObserver(checkLength);
				win.__sheetLiftObserver.observe(page);
				sheet.querySelectorAll<HTMLElement>(":scope > *").forEach((child) => win.__sheetLiftObserver?.observe(child));
				checkLength();

				let frame = 0;
				const update = () => {
					frame = 0;
					page.style.setProperty("--sheet-scroll", `${sheet.scrollTop}px`);
				};
				sheet.addEventListener("scroll", () => {
					if (!frame) frame = requestAnimationFrame(update);
				}, { passive: true });
				update();
			};

			const initMiniBar = () => {
				const win = window as Window & {
					__miniBarObserver?: IntersectionObserver;
				};

				win.__miniBarObserver?.disconnect();

				const sheet = document.querySelector<HTMLElement>(".post-sheet");
				const header = document.querySelector<HTMLElement>(".post-sheet-header");
				const miniBar = document.querySelector<HTMLElement>(".post-mini-bar");
				if (!sheet || !header || !miniBar) return;

				win.__miniBarObserver = new IntersectionObserver((entries) => {
					const entry = entries[0];
					if (!entry) return;
					const isVisible = !entry.isIntersecting;
					miniBar.classList.toggle("is-visible", isVisible);
					miniBar.setAttribute("aria-hidden", isVisible ? "false" : "true");
				}, {
					root: sheet,
					threshold: 0,
				});

				win.__miniBarObserver.observe(header);
			};

			const unfoldToElement = (target: HTMLElement) => {
				let unfolded = false;
				let parent = target.parentElement;
				while (parent && !parent.classList.contains("post-sheet-body")) {
					if (parent.classList.contains("fold-section") && parent.classList.contains("is-folded")) {
						parent.classList.remove("is-folded");
						const toggle = parent.querySelector<HTMLButtonElement>(":scope > .fold-header > .fold-toggle");
						toggle?.setAttribute("aria-expanded", "true");
						unfolded = true;
					}
					parent = parent.parentElement;
				}
				return unfolded;
			};

			const scrollToHeading = (id: string, smooth: boolean) => {
				const target = document.getElementById(id);
				const sheet = document.querySelector<HTMLElement>(".post-sheet");
				if (!target || !sheet) return;

				if (unfoldToElement(target)) {
					updateMathBlocks();
				}

				const sheetRect = sheet.getBoundingClientRect();
				const targetRect = target.getBoundingClientRect();
				const offset = 68;
				const top = Math.max(0, sheet.scrollTop + (targetRect.top - sheetRect.top) - offset);
				sheet.scrollTo({ top, behavior: smooth ? "smooth" : "auto" });
			};

			const revealHashTarget = () => {
				const hash = window.location.hash;
				if (!hash) return;
				const id = decodeURIComponent(hash.slice(1));
				const target = document.getElementById(id);
				if (!target) return;
				if (unfoldToElement(target)) {
					updateMathBlocks();
				}
			};

			let updateTocActive = () => {};

			const initToc = () => {
				const win = window as Window & {
					__tocCleanup?: () => void;
				};
				win.__tocCleanup?.();

				const sheet = document.querySelector<HTMLElement>(".post-sheet");
				const tocNav = document.querySelector<HTMLElement>(".post-toc-nav");
				const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".post-toc-link"));
				if (!sheet || links.length === 0) {
					updateTocActive = () => {};
					return;
				}

				const items = links
					.map((link) => {
						const slug = link.dataset.tocSlug ?? "";
						const heading = slug ? document.getElementById(slug) : null;
						return heading ? { slug, link, heading } : null;
					})
					.filter((item): item is { slug: string; link: HTMLAnchorElement; heading: HTMLElement } => item !== null);

				if (items.length === 0) {
					updateTocActive = () => {};
					return;
				}

				let activeSlug = "";
				let frame = 0;

				const computeActive = () => {
					frame = 0;
					const visibleItems = items.filter((item) => item.heading.getClientRects().length > 0);
					if (visibleItems.length === 0) return;

					const sheetRect = sheet.getBoundingClientRect();
					const triggerTop = sheetRect.top + 96;

					let current = visibleItems[0];
					for (const item of visibleItems) {
						if (item.heading.getBoundingClientRect().top <= triggerTop) {
							current = item;
						} else {
							break;
						}
					}

					const nextSlug = current.slug;
					if (nextSlug === activeSlug) return;
					activeSlug = nextSlug;

					for (const item of items) {
						const isActive = item.slug === activeSlug;
						item.link.classList.toggle("is-active", isActive);
						if (isActive) {
							item.link.setAttribute("aria-current", "location");
						} else {
							item.link.removeAttribute("aria-current");
						}
					}

					if (tocNav && tocNav.scrollHeight > tocNav.clientHeight) {
						const navRect = tocNav.getBoundingClientRect();
						const linkRect = current.link.getBoundingClientRect();
						const pad = 24;
						if (linkRect.top < navRect.top + pad) {
							tocNav.scrollTop += linkRect.top - (navRect.top + pad);
						} else if (linkRect.bottom > navRect.bottom - pad) {
							tocNav.scrollTop += linkRect.bottom - (navRect.bottom - pad);
						}
					}
				};

				const onScroll = () => {
					if (frame) return;
					frame = requestAnimationFrame(computeActive);
				};

				updateTocActive = computeActive;
				sheet.addEventListener("scroll", onScroll, { passive: true });
				computeActive();

				win.__tocCleanup = () => {
					sheet.removeEventListener("scroll", onScroll);
					if (frame) cancelAnimationFrame(frame);
				};
			};

			// Mark display math that had to be shrunk to fit the column as expandable
			const updateMathBlocks = () => {
				document.querySelectorAll<HTMLElement>(".typst-display-wrapper").forEach((wrapper) => {
					const svg = wrapper.querySelector<SVGSVGElement>(".typst-display");
					// Hidden (e.g. inside a folded section): re-measured when it becomes visible
					if (!svg || wrapper.clientWidth === 0) return;
					const naturalWidth = parseFloat(svg.style.width) * parseFloat(getComputedStyle(svg).fontSize);
					const isShrunk = naturalWidth > wrapper.clientWidth + 1;
					wrapper.classList.toggle("is-shrunk", isShrunk);
					if (isShrunk) {
						wrapper.tabIndex = 0;
						wrapper.setAttribute("role", "button");
						wrapper.setAttribute("aria-haspopup", "dialog");
						wrapper.setAttribute("aria-label", "Show equation at full size");
					} else {
						wrapper.removeAttribute("tabindex");
						wrapper.removeAttribute("role");
						wrapper.removeAttribute("aria-haspopup");
						wrapper.removeAttribute("aria-label");
					}
				});
			};

			const getMathPopup = () => {
				let popup = document.querySelector<HTMLDialogElement>(".math-popup");
				if (popup) return popup;

				popup = document.createElement("dialog");
				popup.className = "math-popup";
				popup.setAttribute("aria-label", "Equation");
				popup.innerHTML = '<button type="button" class="math-popup-close" aria-label="Close">esc ✕</button><div class="math-popup-body"></div>';
				popup.querySelector(".math-popup-close")?.addEventListener("click", () => popup?.close());
				// Clicks on the dimmed backdrop land on the dialog element itself
				popup.addEventListener("click", (event) => {
					if (event.target === popup) popup?.close();
				});
				popup.addEventListener("close", () => {
					popup?.querySelector(".math-popup-body")?.replaceChildren();
				});
				document.body.append(popup);
				return popup;
			};

			const openMathPopup = (wrapper: HTMLElement) => {
				const svg = wrapper.querySelector<SVGSVGElement>(".typst-display");
				if (!svg) return;
				const popup = getMathPopup();
				popup.querySelector(".math-popup-body")?.replaceChildren(svg.cloneNode(true));
				popup.showModal();
			};

			document.addEventListener("keydown", (event) => {
				if (event.key !== "Enter" && event.key !== " ") return;
				const wrapper = (event.target as HTMLElement | null)?.closest<HTMLElement>(".typst-display-wrapper.is-shrunk");
				if (!wrapper || wrapper !== event.target) return;
				event.preventDefault();
				openMathPopup(wrapper);
			});

			let mathResizeFrame = 0;
			window.addEventListener("resize", () => {
				cancelAnimationFrame(mathResizeFrame);
				mathResizeFrame = requestAnimationFrame(updateMathBlocks);
			});

			const copyResetTimers = new WeakMap<HTMLButtonElement, number>();

			const copyCode = async (button: HTMLButtonElement) => {
				const code = button.closest(".code-block")?.querySelector("pre code");
				const label = button.querySelector(".code-copy-label");
				if (!code || !label) return;

				let result = "copied";
				try {
					await navigator.clipboard.writeText(code.textContent ?? "");
				} catch {
					result = "failed";
				}

				clearTimeout(copyResetTimers.get(button));
				label.textContent = result;
				button.classList.toggle("is-copied", result === "copied");
				copyResetTimers.set(button, window.setTimeout(() => {
					label.textContent = "copy";
					button.classList.remove("is-copied");
				}, 1600));
			};

			// Global delegated click handler for TOC links, code copy, math popups, fold toggles and badges
			document.addEventListener("click", (event) => {
				const target = event.target as HTMLElement | null;
				if (!target) return;

				const tocLink = target.closest<HTMLAnchorElement>(".post-toc-link");
				if (tocLink) {
					const slug = tocLink.dataset.tocSlug;
					if (slug) {
						event.preventDefault();
						const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
						history.pushState(null, "", `#${encodeURIComponent(slug)}`);
						scrollToHeading(slug, !reduceMotion);
						updateTocActive();
					}
					return;
				}

				const copyBtn = target.closest<HTMLButtonElement>(".code-copy");
				if (copyBtn) {
					copyCode(copyBtn);
					return;
				}

				const mathBlock = target.closest<HTMLElement>(".typst-display-wrapper.is-shrunk");
				if (mathBlock) {
					openMathPopup(mathBlock);
					return;
				}

				const toggleBtn = target.closest<HTMLButtonElement>(".fold-toggle, .fold-badge");
				if (!toggleBtn) return;

				const section = toggleBtn.closest<HTMLElement>(".fold-section");
				if (!section) return;

				const isFolded = section.classList.toggle("is-folded");
				const toggle = section.querySelector<HTMLButtonElement>(":scope > .fold-header > .fold-toggle");
				if (toggle) {
					toggle.setAttribute("aria-expanded", isFolded ? "false" : "true");
				}
				if (!isFolded) updateMathBlocks();
				updateTocActive();
			});

			window.addEventListener("hashchange", revealHashTarget);

			const setupPostPage = () => {
				revealHashTarget();
				initMiniBar();
				initSheetLift();
				initToc();
				updateMathBlocks();
			};

			document.addEventListener("astro:page-load", setupPostPage);

			window.addEventListener("pageshow", (event) => {
				if (event.persisted) {
					setupPostPage();
				}
			});
		</script>
	</body>
</html>
