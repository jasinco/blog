---
import { ClientRouter } from "astro:transitions";
import { getCollection } from "astro:content";
import "../styles/global.css";
// Deep import: the package root pulls in the native renderer, which the Cloudflare build can't bundle
import { getImagePath } from "astro-takumi/dist/util.js";

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
	day: "2-digit",
	month: "long",
	year: "numeric",
});

const posts = (await getCollection("posts"))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.map((post) => ({
		id: post.id,
		title: post.data.title,
		date: dateFormatter.format(post.data.date),
		excerpt: post.data.excerpt,
		tags: post.data.tags ?? [],
	}));

const tagCounts = new Map<string, number>();
posts.forEach((post) => {
	post.tags.forEach((tag) => {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	});
});
const allTags = [...tagCounts.entries()]
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([tag, count]) => ({ tag, count }));
const { url, site } = Astro;
const openGraphImageUrl = getImagePath({ url, site });
const pageTitle = "一人の言葉 — Jasinco's Bewilderments & Personal Notes";
const pageDescription = "A personal collection of bewilderments, essays, and notes on programming, mathematics, and things not quite figured out.";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pageDescription} />

		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={url.href} />
		<meta property="og:image" content={openGraphImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={pageTitle} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={openGraphImageUrl} />
		<meta name="twitter:image:alt" content={pageTitle} />

		<ClientRouter />
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="site-bar" transition:persist>
			<a href="/" class="brand" aria-label="一人の言葉 home">一人の言葉</a>
			<p>Personal notes</p>
		</header>

		<main class="stage landing-stage" transition:animate="fade">
			<canvas class="animation-bg" aria-hidden="true"></canvas>
			<section class="reading-box" aria-labelledby="page-title">
				<div class="box-content">
					<header class="box-header">
						<h1 id="page-title" class="terminal-title">
							<span class="terminal-prompt" aria-hidden="true">jasinco&nbsp;&gt;</span>
							<span class="terminal-static">My</span>
							<span class="terminal-text" aria-live="polite">Bewilderments</span><span class="terminal-cursor" aria-hidden="true">|</span>
						</h1>
						<p>A small collection of things I have not quite figured out.</p>
					</header>

					<div class="tag-filter-bar" role="toolbar" aria-label="Filter posts by tag">
						<button type="button" class="tag-filter-btn is-active" data-tag="all" aria-pressed="true">
							all <span class="tag-count">{posts.length}</span>
						</button>
						{allTags.map(({ tag, count }) => (
							<button type="button" class="tag-filter-btn" data-tag={tag} aria-pressed="false">
								#{tag} <span class="tag-count">{count}</span>
							</button>
						))}
					</div>

					<div class="latest-posts" aria-label="Latest posts">
						{posts.map((post, index) => (
							<article class="post" data-post-index={index + 1} data-tags={JSON.stringify(post.tags)}>
								<p class="post-date">{post.date}</p>
								<div class="post-copy">
									<h2 tabindex="0" role="link">{post.title}</h2>
									<p>{post.excerpt}</p>
									{post.tags.length > 0 && (
										<div class="post-tags" aria-label="Tags">
											{post.tags.map((tag) => (
												<button type="button" class="post-tag-pill" data-tag-filter={tag} title={`Filter by #${tag}`}>
													#{tag}
												</button>
											))}
										</div>
									)}
								</div>
								<a href={`/posts/${post.id}`} aria-label={`Read ${post.title}`}>Read <span aria-hidden="true">↗</span></a>
							</article>
						))}
						<div class="no-posts-found" hidden>
							<p>No notes filed under this tag yet.</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<script>
			import { animate } from "animejs";
			import {
				AdditiveBlending,
				BufferAttribute,
				BufferGeometry,
				CanvasTexture,
				Color,
				LinearFilter,
				PerspectiveCamera,
				Points,
				Scene,
				ShaderMaterial,
				WebGLRenderer,
			} from "three";

			// 3D cmatrix rain: glyph columns at varying depths, falling cell by cell (three.js, 28fps)
			const initMatrix3D = () => {
				const win = window as Window & { __matrix3DStop?: () => void };
				win.__matrix3DStop?.();
				win.__matrix3DStop = undefined;

				const canvas = document.querySelector<HTMLCanvasElement>(".animation-bg");
				if (!canvas) return;

				const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				const streamCount = 280;
				const trailLength = 22; // glyphs per stream
				const cell = 0.9; // world-space glyph height
				const depthRange = [8, 60]; // distance of streams from the camera
				const speedRange = [5, 14]; // cells per second
				const flickerRate = 6; // glyph changes per second
				const fov = 50;
				const frameInterval = 1000 / 28; // cap at 28fps
				const css = getComputedStyle(document.documentElement);
				const trailColor = css.getPropertyValue("--green-ink").trim() || "#b8d2ad";
				const headColor = css.getPropertyValue("--ink").trim() || "#f0f0e8";

				let renderer: WebGLRenderer;
				try {
					renderer = new WebGLRenderer({ canvas, alpha: true, antialias: false });
				} catch {
					return; // No WebGL: leave the background empty
				}
				renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

				const scene = new Scene();
				const camera = new PerspectiveCamera(fov, 1, 0.1, 200);
				camera.position.set(0, 0, 0);

				// Glyph atlas: half-width katakana + digits, mirrored like the film
				const glyphs = "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789:.=*+-<>¦|";
				const atlasCols = 8;
				const atlasCell = 64;
				const atlasCanvas = document.createElement("canvas");
				atlasCanvas.width = atlasCanvas.height = atlasCols * atlasCell;
				const atlasCtx = atlasCanvas.getContext("2d")!;
				const renderAtlas = () => {
					atlasCtx.clearRect(0, 0, atlasCanvas.width, atlasCanvas.height);
					atlasCtx.fillStyle = "#fff";
					atlasCtx.font = `${atlasCell * 0.78}px "Ioskeley Mono", "Noto Sans JP", "Hiragino Sans", monospace`;
					atlasCtx.textAlign = "center";
					atlasCtx.textBaseline = "middle";
					for (let g = 0; g < atlasCols * atlasCols; g++) {
						const cx = (g % atlasCols) * atlasCell + atlasCell / 2;
						const cy = Math.floor(g / atlasCols) * atlasCell + atlasCell / 2;
						atlasCtx.save();
						atlasCtx.translate(cx, cy);
						atlasCtx.scale(-1, 1);
						atlasCtx.fillText(glyphs[g % glyphs.length], 0, 0);
						atlasCtx.restore();
					}
				};
				renderAtlas();
				const atlas = new CanvasTexture(atlasCanvas);
				atlas.minFilter = LinearFilter;
				atlas.generateMipmaps = false;

				let isDisposed = false;
				if (document.fonts) {
					document.fonts.ready.then(() => {
						if (isDisposed) return;
						renderAtlas();
						atlas.needsUpdate = true;
					});
				}

				// One point per glyph; each stream's layout lives in per-vertex attributes
				const total = streamCount * trailLength;
				const aStream = new Float32Array(total * 4); // x, z, top y, fall range
				const aMotion = new Float32Array(total * 4); // speed, phase, trail index, seed
				const halfTan = Math.tan(((fov / 2) * Math.PI) / 180);
				for (let s = 0; s < streamCount; s++) {
					const depth = depthRange[0] + Math.random() * (depthRange[1] - depthRange[0]);
					const halfH = depth * halfTan;
					const x = (Math.random() * 2 - 1) * halfH * 2.2; // wide enough for ultrawide screens
					const top = halfH + cell * 2;
					const range = top * 2 + trailLength * cell;
					const speed = speedRange[0] + Math.random() * (speedRange[1] - speedRange[0]);
					const phase = Math.random() * 1000;
					for (let t = 0; t < trailLength; t++) {
						const i = (s * trailLength + t) * 4;
						aStream.set([x, -depth, top, range], i);
						aMotion.set([speed, phase, t, s * 7.31], i);
					}
				}
				const geometry = new BufferGeometry();
				geometry.setAttribute("position", new BufferAttribute(new Float32Array(total * 3), 3));
				geometry.setAttribute("aStream", new BufferAttribute(aStream, 4));
				geometry.setAttribute("aMotion", new BufferAttribute(aMotion, 4));

				const material = new ShaderMaterial({
					uniforms: {
						uTime: { value: 0 },
						uAtlas: { value: atlas },
						uTrail: { value: new Color(trailColor) },
						uHead: { value: new Color(headColor) },
						uCell: { value: cell },
						uTrailLength: { value: trailLength },
						uFlicker: { value: flickerRate },
						uViewportH: { value: 1 },
						uHalfTan: { value: halfTan },
						uDepthFar: { value: depthRange[1] },
					},
					transparent: true,
					depthWrite: false,
					blending: AdditiveBlending,
					vertexShader: /* glsl */ `
						attribute vec4 aStream;
						attribute vec4 aMotion;
						uniform float uTime;
						uniform float uCell;
						uniform float uTrailLength;
						uniform float uFlicker;
						uniform float uViewportH;
						uniform float uHalfTan;
						uniform float uDepthFar;
						varying float vGlyph;
						varying float vHead;
						varying float vAlpha;

						float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }

						void main() {
							float speed = aMotion.x;
							float trail = aMotion.z;
							float seed = aMotion.w;
							// The head advances whole cells, like a terminal redraw
							float headCell = floor(uTime * speed + aMotion.y);
							float cellsInRange = max(1.0, floor(aStream.w / uCell));
							float row = mod(mod(headCell - trail, cellsInRange) + cellsInRange, cellsInRange);
							float y = aStream.z - row * uCell;

							vec4 mv = modelViewMatrix * vec4(aStream.x, y, aStream.y, 1.0);
							gl_Position = projectionMatrix * mv;
							gl_PointSize = uCell * uViewportH / (2.0 * uHalfTan * max(0.1, -mv.z));

							// Glyph is fixed per screen cell, but re-rolls a few times a second
							float slot = mod(mod(headCell - trail, cellsInRange) + cellsInRange, cellsInRange);
							float change = floor(uTime * uFlicker * (0.3 + hash(vec2(seed, slot))));
							vGlyph = clamp(floor(hash(vec2(seed + slot, change)) * 64.0), 0.0, 63.0);
							vHead = trail < 0.5 ? 1.0 : 0.0;
							float fade = 1.0 - trail / uTrailLength;
							float depthFade = smoothstep(uDepthFar, uDepthFar * 0.25, -mv.z);
							vAlpha = fade * fade * depthFade;
						}
					`,
					fragmentShader: /* glsl */ `
						uniform sampler2D uAtlas;
						uniform vec3 uTrail;
						uniform vec3 uHead;
						varying float vGlyph;
						varying float vHead;
						varying float vAlpha;

						void main() {
							vec2 cellXY = vec2(mod(vGlyph, 8.0), floor(vGlyph / 8.0));
							vec2 uv = vec2((cellXY.x + gl_PointCoord.x) / 8.0, 1.0 - (cellXY.y + gl_PointCoord.y) / 8.0);
							float ink = texture2D(uAtlas, uv).a;
							if (ink < 0.05) discard;
							vec3 color = mix(uTrail, uHead, vHead);
							gl_FragColor = vec4(color, ink * max(vAlpha, vHead));
						}
					`,
				});

				const points = new Points(geometry, material);
				points.frustumCulled = false;
				scene.add(points);

				let frame = 0;
				let lastTick = performance.now();

				const draw = (time: number) => {
					const t = time / 1000;
					material.uniforms.uTime.value = t;
					// Slow drift so the depth reads as 3D
					camera.position.set(Math.sin(t * 0.07) * 2.5, Math.sin(t * 0.05) * 1.2, 0);
					camera.lookAt(Math.sin(t * 0.04) * 1.5, 0, -30);
					renderer.render(scene, camera);
				};

				const resize = () => {
					const rect = canvas.getBoundingClientRect();
					const width = Math.max(1, Math.floor(rect.width));
					const height = Math.max(1, Math.floor(rect.height));
					renderer.setSize(width, height, false);
					camera.aspect = width / height;
					camera.updateProjectionMatrix();
					material.uniforms.uViewportH.value = height * renderer.getPixelRatio();
					draw(lastTick);
				};

				const tick = (time: number) => {
					frame = requestAnimationFrame(tick);
					const elapsed = time - lastTick;
					if (elapsed < frameInterval) return;
					// Snap to the 28fps grid so frames stay evenly spaced instead of drifting
					lastTick = time - (elapsed % frameInterval);
					draw(time);
				};

				resize();
				const observer = new ResizeObserver(resize);
				observer.observe(canvas);
				// Reduced motion: one static frame of rain, no animation loop
				if (!reduceMotion) {
					frame = requestAnimationFrame(tick);
				} else {
					draw(12000);
				}

				win.__matrix3DStop = () => {
					isDisposed = true;
					cancelAnimationFrame(frame);
					observer.disconnect();
					geometry.dispose();
					material.dispose();
					atlas.dispose();
					renderer.dispose();
				};
			};

			const initLandingPage = () => {
				const win = window as Window & {
					__landingAnimations?: {
						typingTimer?: number;
						swapTimer?: number;
						cursorAnimation?: ReturnType<typeof animate>;
					};
				};

				const previousState = win.__landingAnimations;
				previousState?.cursorAnimation?.revert();
				if (previousState?.typingTimer) window.clearTimeout(previousState.typingTimer);
				if (previousState?.swapTimer) window.clearTimeout(previousState.swapTimer);

				const animationState = {
					typingTimer: undefined as number | undefined,
					swapTimer: undefined as number | undefined,
					cursorAnimation: undefined as ReturnType<typeof animate> | undefined,
				};
				win.__landingAnimations = animationState;

				const readingBox = document.querySelector<HTMLElement>(".reading-box");
				const boxContent = document.querySelector<HTMLElement>(".box-content");
				const latestPosts = document.querySelector<HTMLElement>(".latest-posts");
				const terminalText = document.querySelector<HTMLElement>(".terminal-text");
				const terminalCursor = document.querySelector<HTMLElement>(".terminal-cursor");
				const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

				if (!readingBox || !boxContent) return;

				initMatrix3D();

				const startBoxAnimation = () => {
					readingBox.style.transformOrigin = "top center";
					readingBox.style.transform = "scaleX(.14) scaleY(.02)";
					boxContent.style.opacity = "0";
					boxContent.style.transform = "translateY(12px)";

					animate(readingBox, {
						scaleX: 1,
						scaleY: 1,
						duration: 720,
						delay: 40,
						ease: "outExpo",
						onComplete: () => {
							readingBox.style.transform = "";
							animate(boxContent, { opacity: 1, y: 0, duration: 420, ease: "outExpo" });
						},
					});
				};

				if (!reduceMotion) {
					requestAnimationFrame(startBoxAnimation);
				} else {
					boxContent.style.opacity = "1";
					boxContent.style.transform = "none";
					readingBox.style.transform = "none";
				}

				if (terminalText && !reduceMotion) {
					const words = ["Bewilderments", "Wonderings", "Perplexities", "Uncertainties"];
					let currentWord = 0;

					if (terminalCursor) {
						animationState.cursorAnimation = animate(terminalCursor, {
							opacity: [.95, .15],
							duration: 520,
							alternate: true,
							loop: true,
							ease: "linear",
						});
					}

					const typeWord = (nextWord: string) => {
						const state = { characters: 0 };
						animate(state, {
							characters: nextWord.length,
							duration: nextWord.length * 62,
							ease: "linear",
							onUpdate: () => {
								terminalText.textContent = nextWord.slice(0, Math.round(state.characters));
							},
							onComplete: () => {
								animationState.swapTimer = window.setTimeout(cycleWord, 2200);
							},
						});
					};

					const cycleWord = () => {
						const current = terminalText.textContent ?? "";
						const state = { characters: current.length };
						animate(state, {
							characters: 0,
							duration: Math.max(180, current.length * 34),
							ease: "linear",
							onUpdate: () => {
								terminalText.textContent = current.slice(0, Math.round(state.characters));
							},
							onComplete: () => {
								currentWord = (currentWord + 1) % words.length;
								animationState.typingTimer = window.setTimeout(() => typeWord(words[currentWord]), 180);
							},
						});
					};

					animationState.swapTimer = window.setTimeout(cycleWord, 2200);
				}

				const posts = [...document.querySelectorAll<HTMLElement>(".post")];
				const surface = getComputedStyle(document.documentElement).getPropertyValue("--surface").trim();
				const wash = getComputedStyle(document.documentElement).getPropertyValue("--green-wash").trim();

				const hexToRgb = (hex: string) => {
					const normalized = hex.replace("#", "").trim();
					const value = normalized.length === 3 ? normalized.split("").map((v) => v + v).join("") : normalized;
					const num = Number.parseInt(value, 16);
					return { r: (num >> 16) & 255, g: (num >> 8) & 255, b: num & 255 };
				};

				const mixColor = (from: string, to: string, progress: number) => {
					const a = hexToRgb(from);
					const b = hexToRgb(to);
					const clamp = Math.min(1, Math.max(0, progress));
					const r = Math.round(a.r + (b.r - a.r) * clamp);
					const g = Math.round(a.g + (b.g - a.g) * clamp);
					const bChannel = Math.round(a.b + (b.b - a.b) * clamp);
					return `rgb(${r} ${g} ${bChannel})`;
				};



				posts.forEach((post) => {
					if (post.dataset.hoverBound === "true") return;
					post.dataset.hoverBound = "true";
					let hoverAnimation: ReturnType<typeof animate> | null = null;

					const setHover = (to: number, duration: number) => {
						hoverAnimation?.revert();
						const state = { progress: to === 1 ? 0 : 1 };
						hoverAnimation = animate(state, {
							progress: to,
							duration,
							ease: to === 1 ? "outExpo" : "outCubic",
							onUpdate: () => {
								post.style.backgroundColor = mixColor(surface, wash, state.progress);
							},
							onComplete: () => {
								if (to === 0) post.style.backgroundColor = surface;
							},
						});
					};

					post.addEventListener("pointerenter", () => setHover(1, 180));
					post.addEventListener("pointerleave", () => setHover(0, 720));
				});

				const filterButtons = [...document.querySelectorAll<HTMLButtonElement>(".tag-filter-btn")];
				const tagPills = [...document.querySelectorAll<HTMLButtonElement>(".post-tag-pill")];
				const noPostsEl = document.querySelector<HTMLElement>(".no-posts-found");

				const setActiveTag = (selectedTag: string, updateUrl = true) => {
					const currentTag = selectedTag.trim().toLowerCase();

					filterButtons.forEach((btn) => {
						const btnTag = (btn.dataset.tag ?? "").toLowerCase();
						const isActive = btnTag === currentTag;
						btn.classList.toggle("is-active", isActive);
						btn.setAttribute("aria-pressed", isActive ? "true" : "false");
					});

					tagPills.forEach((pill) => {
						const pillTag = (pill.dataset.tagFilter ?? "").toLowerCase();
						pill.classList.toggle("is-active", currentTag !== "all" && pillTag === currentTag);
					});

					let visibleCount = 0;
					posts.forEach((post) => {
						const rawTags = post.dataset.tags ?? "[]";
						let tags: string[] = [];
						try {
							tags = (JSON.parse(rawTags) as string[]).map((t) => t.toLowerCase());
						} catch {
							tags = [];
						}

						const matches = currentTag === "all" || tags.includes(currentTag);
						if (matches) {
							post.style.display = "";
							visibleCount++;
						} else {
							post.style.display = "none";
						}
					});

					if (noPostsEl) {
						noPostsEl.hidden = visibleCount > 0;
					}

					if (updateUrl) {
						const url = new URL(window.location.href);
						if (currentTag === "all") {
							url.searchParams.delete("tag");
						} else {
							url.searchParams.set("tag", currentTag);
						}
						window.history.replaceState(null, "", url.toString());
					}
				};

				const urlTag = new URLSearchParams(window.location.search).get("tag");
				const validTags = filterButtons.map((b) => (b.dataset.tag ?? "").toLowerCase());
				if (urlTag && validTags.includes(urlTag.toLowerCase())) {
					setActiveTag(urlTag, false);
				} else {
					setActiveTag("all", false);
				}

				filterButtons.forEach((btn) => {
					if (btn.dataset.filterBound === "true") return;
					btn.dataset.filterBound = "true";
					btn.addEventListener("click", () => {
						const tag = btn.dataset.tag ?? "all";
						const isCurrentlyActive = btn.classList.contains("is-active") && tag !== "all";
						setActiveTag(isCurrentlyActive ? "all" : tag);
					});
				});

				tagPills.forEach((pill) => {
					if (pill.dataset.filterBound === "true") return;
					pill.dataset.filterBound = "true";
					pill.addEventListener("click", (e) => {
						e.preventDefault();
						e.stopPropagation();
						const tag = pill.dataset.tagFilter ?? "";
						const activeBtn = filterButtons.find((b) => b.classList.contains("is-active"));
						const currentActive = activeBtn?.dataset.tag ?? "all";
						if (currentActive === tag) {
							setActiveTag("all");
						} else {
							setActiveTag(tag);
						}
					});
				});

				const postHeadings = [...document.querySelectorAll<HTMLElement>(".post-copy h2")];
				postHeadings.forEach((h2) => {
					if (h2.dataset.clickBound === "true") return;
					h2.dataset.clickBound = "true";

					const redirectToPost = (e: MouseEvent | KeyboardEvent) => {
						const post = h2.closest<HTMLElement>(".post");
						const readLink = post?.querySelector<HTMLAnchorElement>("a[href^='/posts/']");
						if (!readLink) return;

						if ("metaKey" in e && (e.metaKey || e.ctrlKey)) {
							window.open(readLink.href, "_blank");
						} else {
							readLink.click();
						}
					};

					h2.addEventListener("click", redirectToPost);
					h2.addEventListener("keydown", (e) => {
						if (e.key === "Enter" || e.key === " ") {
							e.preventDefault();
							redirectToPost(e);
						}
					});
				});
			};

			document.addEventListener("astro:before-swap", () => {
				(window as Window & { __matrix3DStop?: () => void }).__matrix3DStop?.();
			});
			document.addEventListener("astro:page-load", initLandingPage);
			window.addEventListener("pageshow", (event) => {
				if (event.persisted) initLandingPage();
			});
		</script>
	</body>
</html>
