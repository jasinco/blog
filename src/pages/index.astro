---
import { ClientRouter } from "astro:transitions";
import { getCollection } from "astro:content";
import "../styles/global.css";

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
	day: "2-digit",
	month: "long",
	year: "numeric",
});

const posts = (await getCollection("posts"))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.map((post) => ({
		id: post.id,
		title: post.data.title,
		date: dateFormatter.format(post.data.date),
		excerpt: post.data.excerpt,
		tags: post.data.tags ?? [],
	}));

const tagCounts = new Map<string, number>();
posts.forEach((post) => {
	post.tags.forEach((tag) => {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	});
});
const allTags = [...tagCounts.entries()]
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([tag, count]) => ({ tag, count }));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="A personal collection of bewilderments and notes." />
		<ClientRouter />
		<title>一人の言葉 — My Bewilderments</title>
	</head>
	<body>
		<header class="site-bar" transition:persist>
			<a href="/" class="brand" aria-label="一人の言葉 home">一人の言葉</a>
			<p>Personal notes</p>
		</header>

		<main class="stage landing-stage" transition:animate="fade">
			<canvas class="animation-bg" aria-hidden="true"></canvas>
			<section class="reading-box" aria-labelledby="page-title">
				<div class="box-content">
					<header class="box-header">
						<h1 id="page-title" class="terminal-title">
							<span class="terminal-prompt" aria-hidden="true">jasinco&nbsp;&gt;</span>
							<span class="terminal-static">My</span>
							<span class="terminal-text" aria-live="polite">Bewilderments</span><span class="terminal-cursor" aria-hidden="true">|</span>
						</h1>
						<p>A small collection of things I have not quite figured out.</p>
					</header>

					<div class="tag-filter-bar" role="toolbar" aria-label="Filter posts by tag">
						<button type="button" class="tag-filter-btn is-active" data-tag="all" aria-pressed="true">
							all <span class="tag-count">{posts.length}</span>
						</button>
						{allTags.map(({ tag, count }) => (
							<button type="button" class="tag-filter-btn" data-tag={tag} aria-pressed="false">
								#{tag} <span class="tag-count">{count}</span>
							</button>
						))}
					</div>

					<div class="latest-posts" aria-label="Latest posts">
						{posts.map((post, index) => (
							<article class="post" data-post-index={index + 1} data-tags={JSON.stringify(post.tags)}>
								<p class="post-date">{post.date}</p>
								<div class="post-copy">
									<h2 tabindex="0" role="link">{post.title}</h2>
									<p>{post.excerpt}</p>
									{post.tags.length > 0 && (
										<div class="post-tags" aria-label="Tags">
											{post.tags.map((tag) => (
												<button type="button" class="post-tag-pill" data-tag-filter={tag} title={`Filter by #${tag}`}>
													#{tag}
												</button>
											))}
										</div>
									)}
								</div>
								<a href={`/posts/${post.id}`} aria-label={`Read ${post.title}`}>Read <span aria-hidden="true">↗</span></a>
							</article>
						))}
						<div class="no-posts-found" hidden>
							<p>No notes filed under this tag yet.</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<script>
			import { animate } from "animejs";

			// cmatrix-style digital rain behind the reading box (throttled canvas 2D, ~18fps)
			const initMatrixRain = () => {
				const win = window as Window & { __matrixStop?: () => void };
				win.__matrixStop?.();
				win.__matrixStop = undefined;

				const canvas = document.querySelector<HTMLCanvasElement>(".animation-bg");
				const ctx = canvas?.getContext("2d");
				if (!canvas || !ctx) return;
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

				const glyphs = "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789:.=*+-<>¦".split("");
				const fontSize = 16;
				const frameInterval = 55;
				const rootStyle = getComputedStyle(document.documentElement);
				const background = rootStyle.getPropertyValue("--canvas").trim() || "#111311";
				const trail = rootStyle.getPropertyValue("--green-ink").trim() || "#b8d2ad";
				const head = rootStyle.getPropertyValue("--ink").trim() || "#f0f0e8";

				let drops: number[] = [];
				let frame = 0;
				let lastTick = 0;

				const resize = () => {
					const rect = canvas.getBoundingClientRect();
					canvas.width = Math.max(1, Math.floor(rect.width));
					canvas.height = Math.max(1, Math.floor(rect.height));
					const columns = Math.ceil(canvas.width / fontSize);
					const rows = Math.ceil(canvas.height / fontSize);
					drops = Array.from({ length: columns }, () => -Math.random() * rows);
					ctx.fillStyle = background;
					ctx.fillRect(0, 0, canvas.width, canvas.height);
					ctx.font = `${fontSize}px monospace`;
					ctx.textBaseline = "top";
				};

				const tick = (time: number) => {
					frame = requestAnimationFrame(tick);
					if (time - lastTick < frameInterval) return;
					lastTick = time;

					// Fade previous frame to leave a trailing tail
					ctx.globalAlpha = 0.13;
					ctx.fillStyle = background;
					ctx.fillRect(0, 0, canvas.width, canvas.height);
					ctx.globalAlpha = 1;

					for (let i = 0; i < drops.length; i++) {
						const y = drops[i] * fontSize;
						if (y >= 0) {
							const x = i * fontSize;
							ctx.fillStyle = Math.random() > 0.94 ? head : trail;
							ctx.fillText(glyphs[Math.floor(Math.random() * glyphs.length)], x, y);
						}
						if (y > canvas.height && Math.random() > 0.975) {
							drops[i] = 0;
						} else {
							drops[i]++;
						}
					}
				};

				resize();
				const observer = new ResizeObserver(resize);
				observer.observe(canvas);
				frame = requestAnimationFrame(tick);

				win.__matrixStop = () => {
					cancelAnimationFrame(frame);
					observer.disconnect();
				};
			};

			const initLandingPage = () => {
				const win = window as Window & {
					__landingAnimations?: {
						typingTimer?: number;
						swapTimer?: number;
						cursorAnimation?: ReturnType<typeof animate>;
					};
				};

				const previousState = win.__landingAnimations;
				previousState?.cursorAnimation?.revert();
				if (previousState?.typingTimer) window.clearTimeout(previousState.typingTimer);
				if (previousState?.swapTimer) window.clearTimeout(previousState.swapTimer);

				const animationState = {
					typingTimer: undefined as number | undefined,
					swapTimer: undefined as number | undefined,
					cursorAnimation: undefined as ReturnType<typeof animate> | undefined,
				};
				win.__landingAnimations = animationState;

				const readingBox = document.querySelector<HTMLElement>(".reading-box");
				const boxContent = document.querySelector<HTMLElement>(".box-content");
				const latestPosts = document.querySelector<HTMLElement>(".latest-posts");
				const terminalText = document.querySelector<HTMLElement>(".terminal-text");
				const terminalCursor = document.querySelector<HTMLElement>(".terminal-cursor");
				const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

				if (!readingBox || !boxContent) return;

				initMatrixRain();

				const startBoxAnimation = () => {
					readingBox.style.transformOrigin = "top center";
					readingBox.style.transform = "scaleX(.14) scaleY(.02)";
					boxContent.style.opacity = "0";
					boxContent.style.transform = "translateY(12px)";

					animate(readingBox, {
						scaleX: 1,
						scaleY: 1,
						duration: 720,
						delay: 40,
						ease: "outExpo",
						onComplete: () => {
							readingBox.style.transform = "";
							animate(boxContent, { opacity: 1, y: 0, duration: 420, ease: "outExpo" });
						},
					});
				};

				if (!reduceMotion) {
					requestAnimationFrame(startBoxAnimation);
				} else {
					boxContent.style.opacity = "1";
					boxContent.style.transform = "none";
					readingBox.style.transform = "none";
				}

				if (terminalText && !reduceMotion) {
					const words = ["Bewilderments", "Wonderings", "Perplexities", "Uncertainties"];
					let currentWord = 0;

					if (terminalCursor) {
						animationState.cursorAnimation = animate(terminalCursor, {
							opacity: [.95, .15],
							duration: 520,
							alternate: true,
							loop: true,
							ease: "linear",
						});
					}

					const typeWord = (nextWord: string) => {
						const state = { characters: 0 };
						animate(state, {
							characters: nextWord.length,
							duration: nextWord.length * 62,
							ease: "linear",
							onUpdate: () => {
								terminalText.textContent = nextWord.slice(0, Math.round(state.characters));
							},
							onComplete: () => {
								animationState.swapTimer = window.setTimeout(cycleWord, 2200);
							},
						});
					};

					const cycleWord = () => {
						const current = terminalText.textContent ?? "";
						const state = { characters: current.length };
						animate(state, {
							characters: 0,
							duration: Math.max(180, current.length * 34),
							ease: "linear",
							onUpdate: () => {
								terminalText.textContent = current.slice(0, Math.round(state.characters));
							},
							onComplete: () => {
								currentWord = (currentWord + 1) % words.length;
								animationState.typingTimer = window.setTimeout(() => typeWord(words[currentWord]), 180);
							},
						});
					};

					animationState.swapTimer = window.setTimeout(cycleWord, 2200);
				}

				const posts = [...document.querySelectorAll<HTMLElement>(".post")];
				const surface = getComputedStyle(document.documentElement).getPropertyValue("--surface").trim();
				const wash = getComputedStyle(document.documentElement).getPropertyValue("--green-wash").trim();

				const hexToRgb = (hex: string) => {
					const normalized = hex.replace("#", "").trim();
					const value = normalized.length === 3 ? normalized.split("").map((v) => v + v).join("") : normalized;
					const num = Number.parseInt(value, 16);
					return { r: (num >> 16) & 255, g: (num >> 8) & 255, b: num & 255 };
				};

				const mixColor = (from: string, to: string, progress: number) => {
					const a = hexToRgb(from);
					const b = hexToRgb(to);
					const clamp = Math.min(1, Math.max(0, progress));
					const r = Math.round(a.r + (b.r - a.r) * clamp);
					const g = Math.round(a.g + (b.g - a.g) * clamp);
					const bChannel = Math.round(a.b + (b.b - a.b) * clamp);
					return `rgb(${r} ${g} ${bChannel})`;
				};



				posts.forEach((post) => {
					if (post.dataset.hoverBound === "true") return;
					post.dataset.hoverBound = "true";
					let hoverAnimation: ReturnType<typeof animate> | null = null;

					const setHover = (to: number, duration: number) => {
						hoverAnimation?.revert();
						const state = { progress: to === 1 ? 0 : 1 };
						hoverAnimation = animate(state, {
							progress: to,
							duration,
							ease: to === 1 ? "outExpo" : "outCubic",
							onUpdate: () => {
								post.style.backgroundColor = mixColor(surface, wash, state.progress);
							},
							onComplete: () => {
								if (to === 0) post.style.backgroundColor = surface;
							},
						});
					};

					post.addEventListener("pointerenter", () => setHover(1, 180));
					post.addEventListener("pointerleave", () => setHover(0, 720));
				});

				const filterButtons = [...document.querySelectorAll<HTMLButtonElement>(".tag-filter-btn")];
				const tagPills = [...document.querySelectorAll<HTMLButtonElement>(".post-tag-pill")];
				const noPostsEl = document.querySelector<HTMLElement>(".no-posts-found");

				const setActiveTag = (selectedTag: string, updateUrl = true) => {
					const currentTag = selectedTag.trim().toLowerCase();

					filterButtons.forEach((btn) => {
						const btnTag = (btn.dataset.tag ?? "").toLowerCase();
						const isActive = btnTag === currentTag;
						btn.classList.toggle("is-active", isActive);
						btn.setAttribute("aria-pressed", isActive ? "true" : "false");
					});

					tagPills.forEach((pill) => {
						const pillTag = (pill.dataset.tagFilter ?? "").toLowerCase();
						pill.classList.toggle("is-active", currentTag !== "all" && pillTag === currentTag);
					});

					let visibleCount = 0;
					posts.forEach((post) => {
						const rawTags = post.dataset.tags ?? "[]";
						let tags: string[] = [];
						try {
							tags = (JSON.parse(rawTags) as string[]).map((t) => t.toLowerCase());
						} catch {
							tags = [];
						}

						const matches = currentTag === "all" || tags.includes(currentTag);
						if (matches) {
							post.style.display = "";
							visibleCount++;
						} else {
							post.style.display = "none";
						}
					});

					if (noPostsEl) {
						noPostsEl.hidden = visibleCount > 0;
					}

					if (updateUrl) {
						const url = new URL(window.location.href);
						if (currentTag === "all") {
							url.searchParams.delete("tag");
						} else {
							url.searchParams.set("tag", currentTag);
						}
						window.history.replaceState(null, "", url.toString());
					}
				};

				const urlTag = new URLSearchParams(window.location.search).get("tag");
				const validTags = filterButtons.map((b) => (b.dataset.tag ?? "").toLowerCase());
				if (urlTag && validTags.includes(urlTag.toLowerCase())) {
					setActiveTag(urlTag, false);
				} else {
					setActiveTag("all", false);
				}

				filterButtons.forEach((btn) => {
					if (btn.dataset.filterBound === "true") return;
					btn.dataset.filterBound = "true";
					btn.addEventListener("click", () => {
						const tag = btn.dataset.tag ?? "all";
						const isCurrentlyActive = btn.classList.contains("is-active") && tag !== "all";
						setActiveTag(isCurrentlyActive ? "all" : tag);
					});
				});

				tagPills.forEach((pill) => {
					if (pill.dataset.filterBound === "true") return;
					pill.dataset.filterBound = "true";
					pill.addEventListener("click", (e) => {
						e.preventDefault();
						e.stopPropagation();
						const tag = pill.dataset.tagFilter ?? "";
						const activeBtn = filterButtons.find((b) => b.classList.contains("is-active"));
						const currentActive = activeBtn?.dataset.tag ?? "all";
						if (currentActive === tag) {
							setActiveTag("all");
						} else {
							setActiveTag(tag);
						}
					});
				});

				const postHeadings = [...document.querySelectorAll<HTMLElement>(".post-copy h2")];
				postHeadings.forEach((h2) => {
					if (h2.dataset.clickBound === "true") return;
					h2.dataset.clickBound = "true";

					const redirectToPost = (e: MouseEvent | KeyboardEvent) => {
						const post = h2.closest<HTMLElement>(".post");
						const readLink = post?.querySelector<HTMLAnchorElement>("a[href^='/posts/']");
						if (!readLink) return;

						if ("metaKey" in e && (e.metaKey || e.ctrlKey)) {
							window.open(readLink.href, "_blank");
						} else {
							readLink.click();
						}
					};

					h2.addEventListener("click", redirectToPost);
					h2.addEventListener("keydown", (e) => {
						if (e.key === "Enter" || e.key === " ") {
							e.preventDefault();
							redirectToPost(e);
						}
					});
				});
			};

			initLandingPage();
			document.addEventListener("astro:page-load", initLandingPage);
			document.addEventListener("astro:after-swap", initLandingPage);
			window.addEventListener("pageshow", (event) => {
				if (event.persisted) initLandingPage();
			});
		</script>
	</body>
</html>
